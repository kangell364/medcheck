# ---------------------------------------------------------------------------
# Texas Insurance Exam Prep Platform — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Supabase Dashboard -> Project Settings -> API).
#
# NEVER commit `.env.local` or any file containing real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PUBLIC (safe to expose to the browser)
#
# These two values are shipped in the client JavaScript bundle by design.
# The anon key is a low-privilege key; all data access it performs is still
# filtered by Row-Level Security. It is NOT a secret in the usual sense, but
# it is still environment-specific, so keep it out of source control.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL of this deployment. Used to build auth redirect URLs
# (email confirmation links). Example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY — DO NOT PREFIX WITH `NEXT_PUBLIC_`
#
# The service-role key bypasses Row-Level Security entirely. It must never be
# imported into a Client Component, never be sent to the browser, and never be
# committed. It is NOT used anywhere in Phase 1; it is documented here only so
# that future server-side administrative jobs have a single sanctioned name.
#
# If you do not need it yet, leave it blank.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
